# =============================================================================
# .env.example — Template para .env.local
# =============================================================================
# Copia la sección que corresponda a .env.local y rellena las claves.
# NO crees variables separadas para local/remoto. Mismo nombre, distinto valor.
# =============================================================================

# ---------------------------------------------------------------------------
# DESARROLLO LOCAL (supabase start → supabase status)
# ---------------------------------------------------------------------------
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="<ANON_KEY de supabase status>"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<PUBLISHABLE_KEY de supabase status>"
# SUPABASE_SERVICE_ROLE_KEY="<SERVICE_ROLE_KEY de supabase status>"
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# PRODUCCIÓN (Vercel env pull / Supabase dashboard)
# ---------------------------------------------------------------------------
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-us-west-1.pooler.supabase.com:6543/postgres"
# NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="<ANON_KEY del dashboard>"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<PUBLISHABLE_KEY del dashboard>"
# SUPABASE_SERVICE_ROLE_KEY="<SERVICE_ROLE_KEY del dashboard>"
# NEXT_PUBLIC_SITE_URL="https://redactor.vercel.app"

# ---------------------------------------------------------------------------
# PROVEEDORES AI (compartido — misma clave en local y remoto)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY="sk-ant-api03-..."
# OPENAI_API_KEY="sk-proj-..."
# GOOGLE_API_KEY="AIza..."
# DEEPSEEK_API_KEY="sk-..."
# COHERE_API_KEY="..."
# SEMANTIC_SCHOLAR_API_KEY="s2k-..."
# EXA_API_KEY="..."
# TAVILY_API_KEY="..."

# ---------------------------------------------------------------------------
# TRIGGER.DEV
# ---------------------------------------------------------------------------
# TRIGGER_SECRET_KEY="tr_dev_..."
# TRIGGER_PROJECT_REF="proj_..."
