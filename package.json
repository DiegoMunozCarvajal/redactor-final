    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^3.2.6",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.3.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.0.0",
