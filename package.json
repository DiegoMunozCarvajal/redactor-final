{
  "name": "redactor-v4",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--no-deprecation --localstorage-file=.next/localstorage' next dev",
    "build": "NODE_OPTIONS='--no-deprecation --localstorage-file=.next/localstorage' next build",
    "start": "NODE_OPTIONS='--no-deprecation --localstorage-file=.next/localstorage' next start",
    "lint": "eslint . --ext .ts,.tsx,.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "audit:template-contamination": "tsx scripts/audit-contamination.ts",
    "regenerate:template": "tsx scripts/regenerate-template.ts",
    "clone:project-to-clean-template": "tsx scripts/clone-project-to-clean-template.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/apply-supabase-migrations.ts",
    "db:migrate:local": "tsx scripts/sync-local-migrations.ts && tsx scripts/apply-supabase-migrations.ts --local",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "trigger:login": "trigger login",
    "trigger:dev": "trigger dev --skip-update-check",
    "trigger:deploy": "trigger deploy"
  },
  "dependencies": {
