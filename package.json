    "lucide-react": "^0.469.0",
    "mammoth": "^1.12.0",
    "motion": "^12.38.0",
    "next": "^15.3.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.9",
    "openai": "^4.77.3",
    "pdfjs-dist": "^5.6.205",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.76.0",
    "react-markdown": "^9.0.3",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "sonner": "^2.0.7",
